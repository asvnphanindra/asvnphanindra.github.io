---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sri Venkata Naga Phanindra Akula',
  description = 'ISAC, O-RAN, and AI — research that becomes tools and teaching.',
} = Astro.props;

const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/products', label: 'Products' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="site-brand" href="/">Sri Venkata Naga Phanindra Akula</a>
        <nav aria-label="Primary">
          <ul class="nav-list">
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={isActive(link.href) ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <p class="footer-brand">Sri Venkata Naga Phanindra Akula</p>
        <p class="footer-meta">&copy; {new Date().getFullYear()} · ISAC · O-RAN · AI</p>
      </footer>
    </div>
  </body>
</html>
