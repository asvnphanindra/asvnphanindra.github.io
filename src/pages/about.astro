---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — ASVN Phanindra" description="About ASVN Phanindra.">
  <section class="page-intro reveal">
    <h1>About</h1>
    <p class="lede">
      I work at the intersection of AI product building, O-RAN research, and teaching.
      This site collects products, course materials, and short notes.
    </p>
  </section>

  <section class="section about-focus reveal" style="--reveal-delay: 80ms">
    <h2>Focus</h2>
    <ul class="focus-list">
      <li>
        <span class="focus-label">AI products</span>
        <span class="focus-copy">Practical tools for classrooms and developers.</span>
      </li>
      <li>
        <span class="focus-label">O-RAN / ISAC</span>
        <span class="focus-copy">Research and system-level simulation work.</span>
      </li>
      <li>
        <span class="focus-label">Teaching</span>
        <span class="focus-copy">Course materials and hands-on camps.</span>
      </li>
    </ul>
  </section>
</BaseLayout>
