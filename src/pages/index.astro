---
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredProducts } from '../data/products';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts.slice(0, 3);
---

<BaseLayout title="Sri Venkata Naga Phanindra Akula — Home">
  <section class="hero reveal">
    <p class="hero-brand">Sri Venkata Naga Phanindra Akula</p>
    <p class="hero-role">
      Faculty · Dr. RVR NRI Institute of Technology (Deemed to be University)
    </p>
    <p class="hero-secondary">
      Educator · Technologist · Research Scientist · AI Product Developer
    </p>
    <h1 class="hero-title">
      ISAC, O-RAN, and AI — research that becomes tools and teaching.
    </h1>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/products">View products</a>
      <a class="btn btn-ghost" href="/blog">Read the blog</a>
    </div>
  </section>

  <section class="section reveal" style="--reveal-delay: 80ms">
    <div class="section-head">
      <h2>Featured products</h2>
      <a class="text-link" href="/products">All products</a>
    </div>
    <ul class="product-grid">
      {
        featuredProducts.map((product) => (
          <li>
            <a
              class="product-card"
              href={product.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="product-card-name">{product.name}</span>
              <span class="product-card-copy">{product.oneLiner}</span>
              <span class="product-card-cta">Open</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section reveal" style="--reveal-delay: 160ms">
    <div class="section-head">
      <h2>Latest posts</h2>
      <a class="text-link" href="/blog">Blog</a>
    </div>
    {
      latest.length === 0 ? (
        <p class="empty">No posts yet.</p>
      ) : (
        <ul class="post-list">
          {latest.map((post) => (
            <li>
              <a class="post-row" href={`/blog/${post.slug}/`}>
                <span class="post-row-title">{post.data.title}</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
